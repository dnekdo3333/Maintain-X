// Restaurant Maintenance & Operations platform — PostgreSQL schema.
//
// Conventions
//  - UUID primary keys, snake_case table/column names, timestamptz everywhere.
//  - Aggregate roots carry organization_id; restaurant-scoped roots carry restaurant_id.
//  - Business entities are archived (archived_at), never hard-deleted.
//  - Append-only tables: *_history, inventory_transactions, audit_logs, attachments.
//  - Required relations default to ON DELETE RESTRICT; pure child rows cascade.

generator client {
  provider      = "prisma-client-js"
  /// native for local machines; rhel-openssl-3.0.x for Vercel serverless functions.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums (mirrored in packages/shared/src/enums.ts — a test keeps them in sync)
// =============================================================================

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum RoleKind {
  ADMIN
  WORKER
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  ASSIGN
  APPROVE
  EXPORT
}

enum RestaurantStatus {
  ACTIVE
  INACTIVE
}

enum LocationType {
  KITCHEN
  HOT_KITCHEN
  COLD_KITCHEN
  PREPARATION
  DISHWASHING
  DINING
  STORAGE
  BAR
  UTILITY
  OFFICE
  OTHER
}

enum AssetStatus {
  OPERATIONAL
  UNDER_MAINTENANCE
  BROKEN
  INACTIVE
  RETIRED
}

enum AssetEventType {
  CREATED
  UPDATED
  STATUS_CHANGED
  MOVED
  WORK_ORDER_COMPLETED
  PART_REPLACED
  DOCUMENT_ADDED
  NOTE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WorkOrderStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  REVIEW
  CLOSED
}

enum WorkOrderType {
  REACTIVE
  PREVENTIVE
  INSPECTION_FOLLOWUP
}

enum WorkOrderCategory {
  REFRIGERATION
  AC
  ELECTRICAL
  PLUMBING
  GAS
  FIRE_SAFETY
  KITCHEN_EQUIPMENT
  PEST_CONTROL
  CLEANING
  IT_POS
  CIVIL
  OTHER
}

enum RequestStatus {
  NEW
  CONVERTED
  REJECTED
}

enum StepInputType {
  PASS_FAIL_NA
  NUMBER
  TEXT
}

enum StepResult {
  PASS
  FAIL
  NA
}

enum AttachmentOwnerType {
  WORK_ORDER
  REQUEST
  CHECKLIST_ITEM
  INSPECTION_ITEM
  MESSAGE
}

enum AttachmentKind {
  PHOTO
  VIDEO
  FILE
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  CUSTOM
}

enum InspectionType {
  OPENING
  CLOSING
  SAFETY
  ASSET
}

enum InspectionStatus {
  IN_PROGRESS
  SUBMITTED
}

enum InventoryTxnType {
  RECEIPT
  CONSUMPTION
  ADJUSTMENT
  RETURN
  TRANSFER
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum VendorCategory {
  REFRIGERATION
  AC
  ELECTRICAL
  PLUMBING
  GAS
  FIRE_SAFETY
  KITCHEN_EQUIPMENT
  PEST_CONTROL
  OTHER
}

enum DocumentOwnerType {
  RESTAURANT
  ASSET
  VENDOR
  WORK_ORDER
}

enum DocumentType {
  LICENSE
  CERTIFICATE
  AMC
  CONTRACT
  MANUAL
  WARRANTY
  INVOICE
  SERVICE
  OTHER
}

enum NotificationType {
  NEW_REQUEST
  TASK_ASSIGNED
  TASK_OVERDUE
  PM_DUE
  CRITICAL_ISSUE
  LOW_STOCK
  PO_APPROVAL
  WARRANTY_EXPIRY
  TASK_COMPLETED
  INSPECTION_FAILED
  NEW_MESSAGE
  DOCUMENT_EXPIRY
}

enum SettingScope {
  ORGANIZATION
  RESTAURANT
}

enum AuditEntityType {
  USER
  ROLE
  TEAM
  RESTAURANT
  LOCATION
  ASSET
  REQUEST
  WORK_ORDER
  PROCEDURE
  PM_SCHEDULE
  INSPECTION
  PART
  INVENTORY
  VENDOR
  PURCHASE_ORDER
  DOCUMENT
  SETTING
  AUTH
  REPORT
}

// =============================================================================
// Organization, identity & access
// =============================================================================

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  timezone  String   @default("Asia/Kolkata")
  currency  String   @default("INR")
  locale    String   @default("en")
  logoKey   String?  @map("logo_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  users                 User[]
  roles                 Role[]
  teams                 Team[]
  restaurants           Restaurant[]
  locations             Location[]
  assetCategories       AssetCategory[]
  assets                Asset[]
  requests              Request[]
  workOrders            WorkOrder[]
  procedures            Procedure[]
  pmSchedules           PmSchedule[]
  inspectionTemplates   InspectionTemplate[]
  inspections           Inspection[]
  parts                 Part[]
  inventory             Inventory[]
  inventoryTransactions InventoryTransaction[]
  vendors               Vendor[]
  vendorInvoices        VendorInvoice[]
  purchaseOrders        PurchaseOrder[]
  documents             Document[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  settings              Setting[]
  counters              Counter[]

  @@map("organizations")
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  organizationId     String     @map("organization_id") @db.Uuid
  email              String?
  username           String?
  phone              String?
  passwordHash       String     @map("password_hash")
  firstName          String     @map("first_name")
  lastName           String     @map("last_name")
  preferredLocale    String     @default("en") @map("preferred_locale")
  status             UserStatus @default(ACTIVE)
  avatarKey          String?    @map("avatar_key")
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz
  /// Bumped to invalidate every session (password change, role/restaurant change, admin revoke).
  tokenVersion       Int        @default(1) @map("token_version")
  archivedAt         DateTime?  @map("archived_at") @db.Timestamptz
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])

  userRoles                UserRole[]
  userRestaurants          UserRestaurant[]
  refreshTokens            RefreshToken[]
  teamMemberships          TeamMember[]
  ledTeams                 Team[]                   @relation("TeamLead")
  requestsMade             Request[]                @relation("RequestRequester")
  requestsReviewed         Request[]                @relation("RequestReviewer")
  assignedWorkOrders       WorkOrder[]              @relation("WorkOrderAssignee")
  createdWorkOrders        WorkOrder[]              @relation("WorkOrderCreator")
  closedWorkOrders         WorkOrder[]              @relation("WorkOrderCloser")
  workOrderStatusChanges   WorkOrderStatusHistory[]
  checklistCompletions     WorkOrderChecklistItem[]
  timeEntries              WorkOrderTimeEntry[]
  messages                 Message[]
  attachments              Attachment[]
  assetHistoryEvents       AssetHistory[]
  pmSchedulesAsAssignee    PmSchedule[]             @relation("PmDefaultAssignee")
  inspectionsPerformed     Inspection[]
  inventoryTransactions    InventoryTransaction[]
  purchaseOrdersRequested  PurchaseOrder[]          @relation("PoRequester")
  purchaseOrdersApproved   PurchaseOrder[]          @relation("PoApprover")
  poReceipts               PoReceipt[]
  documentsUploaded        Document[]
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]
  auditLogs                AuditLog[]

  @@unique([organizationId, email])
  @@unique([organizationId, username])
  @@unique([organizationId, phone])
  @@index([organizationId, status])
  @@map("users")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  /// Which shell the role lands in: ADMIN (desktop) or WORKER (mobile-first).
  kind           RoleKind @default(ADMIN)
  isSystem       Boolean  @default(false) @map("is_system")
  /// SUPER_ADMIN | ADMIN | WORKER for system roles; null for custom roles.
  systemKey      String?  @map("system_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization     @relation(fields: [organizationId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, name])
  @@unique([organizationId, systemKey])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  /// e.g. "work_orders:assign"
  key         String           @unique
  resource    String
  action      PermissionAction
  description String?

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Restaurant scope: which restaurants a user may see/act on. Super Admin bypasses this.
model UserRestaurant {
  userId       String   @map("user_id") @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([userId, restaurantId])
  @@index([restaurantId])
  @@map("user_restaurants")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  /// All rotations of one login share a family; reuse of a revoked token revokes the family.
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Team {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  /// Null = organization-wide team.
  restaurantId   String?   @map("restaurant_id") @db.Uuid
  name           String
  description    String?
  leadUserId     String?   @map("lead_user_id") @db.Uuid
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  restaurant   Restaurant?  @relation(fields: [restaurantId], references: [id])
  lead         User?        @relation("TeamLead", fields: [leadUserId], references: [id])
  members      TeamMember[]
  workOrders   WorkOrder[]
  pmSchedules  PmSchedule[]

  @@unique([organizationId, name])
  @@index([restaurantId])
  @@map("teams")
}

model TeamMember {
  teamId   String   @map("team_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

// =============================================================================
// Restaurants & locations
// =============================================================================

model Restaurant {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  /// Short human code, e.g. "R1", "BKD-SG".
  code           String
  name           String
  addressLine1   String?          @map("address_line1")
  addressLine2   String?          @map("address_line2")
  city           String?
  state          String?
  postalCode     String?          @map("postal_code")
  phone          String?
  email          String?
  timezone       String           @default("Asia/Kolkata")
  /// "HH:mm" local time; used by opening/closing inspection reminders.
  opensAt        String?          @map("opens_at")
  closesAt       String?          @map("closes_at")
  status         RestaurantStatus @default(ACTIVE)
  archivedAt     DateTime?        @map("archived_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])

  locations             Location[]
  userRestaurants       UserRestaurant[]
  teams                 Team[]
  assets                Asset[]
  requests              Request[]
  workOrders            WorkOrder[]
  procedures            Procedure[]
  pmSchedules           PmSchedule[]
  inspectionTemplates   InspectionTemplate[]
  inspections           Inspection[]
  inventory             Inventory[]
  inventoryTransactions InventoryTransaction[]
  vendorRestaurants     VendorRestaurant[]
  vendorInvoices        VendorInvoice[]
  purchaseOrders        PurchaseOrder[]
  documents             Document[]
  auditLogs             AuditLog[]
  settings              Setting[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("restaurants")
}

model Location {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  restaurantId   String       @map("restaurant_id") @db.Uuid
  parentId       String?      @map("parent_id") @db.Uuid
  name           String
  type           LocationType @default(OTHER)
  description    String?
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])
  parent       Location?    @relation("LocationTree", fields: [parentId], references: [id])
  children     Location[]   @relation("LocationTree")
  assets       Asset[]
  requests     Request[]
  workOrders   WorkOrder[]

  @@unique([restaurantId, name])
  @@index([restaurantId, type])
  @@map("locations")
}

// =============================================================================
// Assets
// =============================================================================

model AssetCategory {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  name               String
  iconKey            String?   @map("icon_key")
  /// Procedure offered by default when creating work orders for this category.
  defaultProcedureId String?   @map("default_procedure_id") @db.Uuid
  archivedAt         DateTime? @map("archived_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization     Organization @relation(fields: [organizationId], references: [id])
  defaultProcedure Procedure?   @relation(fields: [defaultProcedureId], references: [id])
  assets           Asset[]

  @@unique([organizationId, name])
  @@map("asset_categories")
}

model Asset {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  /// Random, unguessable id embedded in the QR code URL (/a/<publicId>).
  publicId       String      @unique @map("public_id")
  /// Human code, e.g. AST-0042.
  assetCode      String      @map("asset_code")
  name           String
  categoryId     String      @map("category_id") @db.Uuid
  restaurantId   String      @map("restaurant_id") @db.Uuid
  locationId     String?     @map("location_id") @db.Uuid
  manufacturer   String?
  model          String?
  serialNumber   String?     @map("serial_number")
  purchaseDate   DateTime?   @map("purchase_date") @db.Date
  purchaseCost   Decimal?    @map("purchase_cost") @db.Decimal(12, 2)
  warrantyStart  DateTime?   @map("warranty_start") @db.Date
  warrantyEnd    DateTime?   @map("warranty_end") @db.Date
  vendorId       String?     @map("vendor_id") @db.Uuid
  status         AssetStatus @default(OPERATIONAL)
  imageKey       String?     @map("image_key")
  notes          String?
  archivedAt     DateTime?   @map("archived_at") @db.Timestamptz
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization  @relation(fields: [organizationId], references: [id])
  category     AssetCategory @relation(fields: [categoryId], references: [id])
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id])
  location     Location?     @relation(fields: [locationId], references: [id])
  vendor       Vendor?       @relation(fields: [vendorId], references: [id])

  history     AssetHistory[]
  downtimes   AssetDowntime[]
  requests    Request[]
  workOrders  WorkOrder[]
  pmSchedules PmSchedule[]
  inspections Inspection[]

  @@unique([organizationId, assetCode])
  @@index([restaurantId, status])
  @@index([categoryId])
  @@index([warrantyEnd])
  @@index([serialNumber])
  @@map("assets")
}

/// Append-only timeline shown as "Maintenance History" on the asset page.
model AssetHistory {
  id          String         @id @default(uuid()) @db.Uuid
  assetId     String         @map("asset_id") @db.Uuid
  eventType   AssetEventType @map("event_type")
  workOrderId String?        @map("work_order_id") @db.Uuid
  actorId     String?        @map("actor_id") @db.Uuid
  oldValue    Json?          @map("old_value")
  newValue    Json?          @map("new_value")
  note        String?
  occurredAt  DateTime       @default(now()) @map("occurred_at") @db.Timestamptz

  asset     Asset      @relation(fields: [assetId], references: [id])
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])
  actor     User?      @relation(fields: [actorId], references: [id])

  @@index([assetId, occurredAt])
  @@map("asset_history")
}

/// Opened when an asset becomes BROKEN, closed when it is OPERATIONAL again.
model AssetDowntime {
  id          String    @id @default(uuid()) @db.Uuid
  assetId     String    @map("asset_id") @db.Uuid
  workOrderId String?   @map("work_order_id") @db.Uuid
  startedAt   DateTime  @map("started_at") @db.Timestamptz
  endedAt     DateTime? @map("ended_at") @db.Timestamptz
  reason      String?

  asset     Asset      @relation(fields: [assetId], references: [id])
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])

  @@index([assetId, startedAt])
  @@map("asset_downtime")
}

// =============================================================================
// Requests (problem reports) & work orders
// =============================================================================

model Request {
  id                   String            @id @default(uuid()) @db.Uuid
  organizationId       String            @map("organization_id") @db.Uuid
  /// REQ-000123
  code                 String
  restaurantId         String            @map("restaurant_id") @db.Uuid
  locationId           String?           @map("location_id") @db.Uuid
  assetId              String?           @map("asset_id") @db.Uuid
  category             WorkOrderCategory @default(OTHER)
  title                String
  description          String
  priority             Priority          @default(MEDIUM)
  status               RequestStatus     @default(NEW)
  requestedById        String            @map("requested_by_id") @db.Uuid
  reviewedById         String?           @map("reviewed_by_id") @db.Uuid
  reviewedAt           DateTime?         @map("reviewed_at") @db.Timestamptz
  rejectionReason      String?           @map("rejection_reason")
  convertedWorkOrderId String?           @unique @map("converted_work_order_id") @db.Uuid
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  organization       Organization @relation(fields: [organizationId], references: [id])
  restaurant         Restaurant   @relation(fields: [restaurantId], references: [id])
  location           Location?    @relation(fields: [locationId], references: [id])
  asset              Asset?       @relation(fields: [assetId], references: [id])
  requestedBy        User         @relation("RequestRequester", fields: [requestedById], references: [id])
  reviewedBy         User?        @relation("RequestReviewer", fields: [reviewedById], references: [id])
  convertedWorkOrder WorkOrder?   @relation("RequestConversion", fields: [convertedWorkOrderId], references: [id])

  @@unique([organizationId, code])
  @@index([restaurantId, status, createdAt])
  @@index([requestedById])
  @@map("requests")
}

model WorkOrder {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  /// WO-000123
  code             String
  title            String
  description      String?
  type             WorkOrderType     @default(REACTIVE)
  category         WorkOrderCategory @default(OTHER)
  restaurantId     String            @map("restaurant_id") @db.Uuid
  locationId       String?           @map("location_id") @db.Uuid
  assetId          String?           @map("asset_id") @db.Uuid
  priority         Priority          @default(MEDIUM)
  status           WorkOrderStatus   @default(OPEN)
  assignedUserId   String?           @map("assigned_user_id") @db.Uuid
  assignedTeamId   String?           @map("assigned_team_id") @db.Uuid
  dueDate          DateTime?         @map("due_date") @db.Timestamptz
  estimatedMinutes Int?              @map("estimated_minutes")
  actualMinutes    Int?              @map("actual_minutes")
  procedureId      String?           @map("procedure_id") @db.Uuid
  pmScheduleId     String?           @map("pm_schedule_id") @db.Uuid
  /// The occurrence this PM work order represents; unique per schedule to prevent duplicates.
  pmDueDate        DateTime?         @map("pm_due_date") @db.Date
  createdById      String            @map("created_by_id") @db.Uuid
  startedAt        DateTime?         @map("started_at") @db.Timestamptz
  completedAt      DateTime?         @map("completed_at") @db.Timestamptz
  closedAt         DateTime?         @map("closed_at") @db.Timestamptz
  closedById       String?           @map("closed_by_id") @db.Uuid
  reopenCount      Int               @default(0) @map("reopen_count")
  holdReason       String?           @map("hold_reason")
  completionNotes  String?           @map("completion_notes")
  archivedAt       DateTime?         @map("archived_at") @db.Timestamptz
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  organization  Organization @relation(fields: [organizationId], references: [id])
  restaurant    Restaurant   @relation(fields: [restaurantId], references: [id])
  location      Location?    @relation(fields: [locationId], references: [id])
  asset         Asset?       @relation(fields: [assetId], references: [id])
  assignedUser  User?        @relation("WorkOrderAssignee", fields: [assignedUserId], references: [id])
  assignedTeam  Team?        @relation(fields: [assignedTeamId], references: [id])
  procedure     Procedure?   @relation(fields: [procedureId], references: [id])
  pmSchedule    PmSchedule?  @relation(fields: [pmScheduleId], references: [id])
  createdBy     User         @relation("WorkOrderCreator", fields: [createdById], references: [id])
  closedBy      User?        @relation("WorkOrderCloser", fields: [closedById], references: [id])
  sourceRequest Request?     @relation("RequestConversion")

  statusHistory          WorkOrderStatusHistory[]
  checklistItems         WorkOrderChecklistItem[]
  parts                  WorkOrderPart[]
  timeEntries            WorkOrderTimeEntry[]
  messages               Message[]
  assetHistory           AssetHistory[]
  downtimes              AssetDowntime[]
  correctiveForChecklist WorkOrderChecklistItem[] @relation("ChecklistCorrectiveWorkOrder")
  correctiveForInspection InspectionItem[]        @relation("InspectionCorrectiveWorkOrder")
  vendorInvoices         VendorInvoice[]

  @@unique([organizationId, code])
  @@unique([pmScheduleId, pmDueDate])
  @@index([restaurantId, status])
  @@index([assignedUserId, status])
  @@index([assignedTeamId, status])
  @@index([dueDate])
  /// Overdue scans: active statuses with a due date in the past.
  @@index([status, dueDate])
  @@index([assetId])
  @@index([createdAt])
  @@map("work_orders")
}

model WorkOrderStatusHistory {
  id          String           @id @default(uuid()) @db.Uuid
  workOrderId String           @map("work_order_id") @db.Uuid
  fromStatus  WorkOrderStatus? @map("from_status")
  toStatus    WorkOrderStatus  @map("to_status")
  actorId     String?          @map("actor_id") @db.Uuid
  note        String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id])

  @@index([workOrderId, createdAt])
  @@map("work_order_status_history")
}

/// Snapshot of procedure steps at the time the work order was created,
/// so editing a procedure later never rewrites history.
model WorkOrderChecklistItem {
  id                    String        @id @default(uuid()) @db.Uuid
  workOrderId           String        @map("work_order_id") @db.Uuid
  position              Int
  title                 String
  instruction           String?
  inputType             StepInputType @default(PASS_FAIL_NA) @map("input_type")
  unit                  String?
  minValue              Decimal?      @map("min_value") @db.Decimal(12, 3)
  maxValue              Decimal?      @map("max_value") @db.Decimal(12, 3)
  required              Boolean       @default(true)
  result                StepResult?
  numericValue          Decimal?      @map("numeric_value") @db.Decimal(12, 3)
  textValue             String?       @map("text_value")
  note                  String?
  completedById         String?       @map("completed_by_id") @db.Uuid
  completedAt           DateTime?     @map("completed_at") @db.Timestamptz
  correctiveWorkOrderId String?       @map("corrective_work_order_id") @db.Uuid
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  workOrder           WorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  completedBy         User?      @relation(fields: [completedById], references: [id])
  correctiveWorkOrder WorkOrder? @relation("ChecklistCorrectiveWorkOrder", fields: [correctiveWorkOrderId], references: [id])

  @@unique([workOrderId, position])
  @@map("work_order_checklist_items")
}

model WorkOrderPart {
  id               String   @id @default(uuid()) @db.Uuid
  workOrderId      String   @map("work_order_id") @db.Uuid
  partId           String   @map("part_id") @db.Uuid
  qtyRequired      Decimal  @default(0) @map("qty_required") @db.Decimal(12, 3)
  qtyUsed          Decimal  @default(0) @map("qty_used") @db.Decimal(12, 3)
  /// Unit cost at the time of use, for cost reports.
  unitCostSnapshot Decimal? @map("unit_cost_snapshot") @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  part      Part      @relation(fields: [partId], references: [id])

  @@unique([workOrderId, partId])
  @@index([partId])
  @@map("work_order_parts")
}

model WorkOrderTimeEntry {
  id          String    @id @default(uuid()) @db.Uuid
  workOrderId String    @map("work_order_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  startedAt   DateTime  @map("started_at") @db.Timestamptz
  endedAt     DateTime? @map("ended_at") @db.Timestamptz
  minutes     Int?
  note        String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([workOrderId])
  @@index([userId, startedAt])
  @@map("work_order_time_entries")
}

/// Admin ↔ Worker conversation on a work order. Part of the work order's history.
model Message {
  id          String    @id @default(uuid()) @db.Uuid
  workOrderId String    @map("work_order_id") @db.Uuid
  authorId    String    @map("author_id") @db.Uuid
  body        String
  editedAt    DateTime? @map("edited_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id])

  @@index([workOrderId, createdAt])
  @@map("messages")
}

/// Photos, videos and files attached to work orders, requests, checklist items and messages.
model Attachment {
  id           String              @id @default(uuid()) @db.Uuid
  ownerType    AttachmentOwnerType @map("owner_type")
  ownerId      String              @map("owner_id") @db.Uuid
  kind         AttachmentKind
  storageKey   String              @unique @map("storage_key")
  thumbKey     String?             @map("thumb_key")
  fileName     String              @map("file_name")
  mimeType     String              @map("mime_type")
  sizeBytes    Int                 @map("size_bytes")
  width        Int?
  height       Int?
  durationSec  Int?                @map("duration_sec")
  uploadedById String              @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([ownerType, ownerId])
  @@map("attachments")
}

// =============================================================================
// Procedures, preventive maintenance, inspections
// =============================================================================

model Procedure {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  /// Null = available to every restaurant.
  restaurantId   String?            @map("restaurant_id") @db.Uuid
  name           String
  category       WorkOrderCategory?
  description    String?
  version        Int                @default(1)
  archivedAt     DateTime?          @map("archived_at") @db.Timestamptz
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  restaurant   Restaurant?  @relation(fields: [restaurantId], references: [id])

  steps               ProcedureStep[]
  workOrders          WorkOrder[]
  pmSchedules         PmSchedule[]
  inspectionTemplates InspectionTemplate[]
  assetCategories     AssetCategory[]

  @@unique([organizationId, name])
  @@index([restaurantId])
  @@map("procedures")
}

model ProcedureStep {
  id          String        @id @default(uuid()) @db.Uuid
  procedureId String        @map("procedure_id") @db.Uuid
  position    Int
  title       String
  instruction String?
  inputType   StepInputType @default(PASS_FAIL_NA) @map("input_type")
  unit        String?
  /// For NUMBER steps: a reading outside [min, max] auto-fails.
  minValue    Decimal?      @map("min_value") @db.Decimal(12, 3)
  maxValue    Decimal?      @map("max_value") @db.Decimal(12, 3)
  required    Boolean       @default(true)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  procedure Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@unique([procedureId, position])
  @@map("procedure_steps")
}

model PmSchedule {
  id                    String            @id @default(uuid()) @db.Uuid
  organizationId        String            @map("organization_id") @db.Uuid
  restaurantId          String            @map("restaurant_id") @db.Uuid
  assetId               String?           @map("asset_id") @db.Uuid
  name                  String
  description           String?
  frequency             Frequency
  /// CUSTOM: every N days.
  intervalDays          Int?              @map("interval_days")
  /// WEEKLY: 0 = Sunday … 6 = Saturday.
  daysOfWeek            Int[]             @default([]) @map("days_of_week")
  /// MONTHLY / QUARTERLY: 1–28.
  dayOfMonth            Int?              @map("day_of_month")
  /// "HH:mm" local time the generated work order is due.
  timeOfDay             String?           @map("time_of_day")
  procedureId           String?           @map("procedure_id") @db.Uuid
  category              WorkOrderCategory @default(OTHER)
  priority              Priority          @default(MEDIUM)
  defaultAssigneeUserId String?           @map("default_assignee_user_id") @db.Uuid
  defaultAssigneeTeamId String?           @map("default_assignee_team_id") @db.Uuid
  estimatedMinutes      Int?              @map("estimated_minutes")
  /// Generate the work order this many days before it is due.
  leadTimeDays          Int               @default(0) @map("lead_time_days")
  startDate             DateTime          @map("start_date") @db.Date
  endDate               DateTime?         @map("end_date") @db.Date
  nextDueAt             DateTime          @map("next_due_at") @db.Timestamptz
  lastGeneratedAt       DateTime?         @map("last_generated_at") @db.Timestamptz
  active                Boolean           @default(true)
  archivedAt            DateTime?         @map("archived_at") @db.Timestamptz
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  organization        Organization @relation(fields: [organizationId], references: [id])
  restaurant          Restaurant   @relation(fields: [restaurantId], references: [id])
  asset               Asset?       @relation(fields: [assetId], references: [id])
  procedure           Procedure?   @relation(fields: [procedureId], references: [id])
  defaultAssigneeUser User?        @relation("PmDefaultAssignee", fields: [defaultAssigneeUserId], references: [id])
  defaultAssigneeTeam Team?        @relation(fields: [defaultAssigneeTeamId], references: [id])
  workOrders          WorkOrder[]

  @@index([organizationId, active, nextDueAt])
  @@index([restaurantId])
  @@index([assetId])
  @@map("pm_schedules")
}

model InspectionTemplate {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  restaurantId   String?        @map("restaurant_id") @db.Uuid
  type           InspectionType
  name           String
  procedureId    String         @map("procedure_id") @db.Uuid
  active         Boolean        @default(true)
  archivedAt     DateTime?      @map("archived_at") @db.Timestamptz
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  restaurant   Restaurant?  @relation(fields: [restaurantId], references: [id])
  procedure    Procedure    @relation(fields: [procedureId], references: [id])
  inspections  Inspection[]

  @@unique([organizationId, name])
  @@index([type, restaurantId])
  @@map("inspection_templates")
}

model Inspection {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  /// INS-000123
  code           String
  templateId     String           @map("template_id") @db.Uuid
  restaurantId   String           @map("restaurant_id") @db.Uuid
  assetId        String?          @map("asset_id") @db.Uuid
  type           InspectionType
  performedById  String           @map("performed_by_id") @db.Uuid
  status         InspectionStatus @default(IN_PROGRESS)
  startedAt      DateTime         @default(now()) @map("started_at") @db.Timestamptz
  submittedAt    DateTime?        @map("submitted_at") @db.Timestamptz
  passCount      Int              @default(0) @map("pass_count")
  failCount      Int              @default(0) @map("fail_count")
  naCount        Int              @default(0) @map("na_count")
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization       @relation(fields: [organizationId], references: [id])
  template     InspectionTemplate @relation(fields: [templateId], references: [id])
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id])
  asset        Asset?             @relation(fields: [assetId], references: [id])
  performedBy  User               @relation(fields: [performedById], references: [id])
  items        InspectionItem[]

  @@unique([organizationId, code])
  @@index([restaurantId, type, submittedAt])
  @@index([performedById])
  @@map("inspections")
}

model InspectionItem {
  id                    String        @id @default(uuid()) @db.Uuid
  inspectionId          String        @map("inspection_id") @db.Uuid
  position              Int
  title                 String
  instruction           String?
  inputType             StepInputType @default(PASS_FAIL_NA) @map("input_type")
  unit                  String?
  minValue              Decimal?      @map("min_value") @db.Decimal(12, 3)
  maxValue              Decimal?      @map("max_value") @db.Decimal(12, 3)
  required              Boolean       @default(true)
  result                StepResult?
  numericValue          Decimal?      @map("numeric_value") @db.Decimal(12, 3)
  textValue             String?       @map("text_value")
  note                  String?
  completedAt           DateTime?     @map("completed_at") @db.Timestamptz
  correctiveWorkOrderId String?       @map("corrective_work_order_id") @db.Uuid

  inspection          Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  correctiveWorkOrder WorkOrder? @relation("InspectionCorrectiveWorkOrder", fields: [correctiveWorkOrderId], references: [id])

  @@unique([inspectionId, position])
  @@map("inspection_items")
}

// =============================================================================
// Inventory
// =============================================================================

model Part {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  name              String
  partNumber        String    @map("part_number")
  category          String?
  unit              String    @default("pcs")
  unitCost          Decimal   @default(0) @map("unit_cost") @db.Decimal(12, 2)
  /// Default minimum; may be overridden per restaurant in `inventory`.
  minStock          Decimal   @default(0) @map("min_stock") @db.Decimal(12, 3)
  preferredVendorId String?   @map("preferred_vendor_id") @db.Uuid
  storageLocation   String?   @map("storage_location")
  description       String?
  imageKey          String?   @map("image_key")
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization @relation(fields: [organizationId], references: [id])
  preferredVendor Vendor?      @relation(fields: [preferredVendorId], references: [id])

  inventory          Inventory[]
  transactions       InventoryTransaction[]
  workOrderParts     WorkOrderPart[]
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([organizationId, partNumber])
  @@index([organizationId, category])
  @@map("parts")
}

/// Current stock of a part at a restaurant. Always equals the sum of its transactions.
model Inventory {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  partId          String   @map("part_id") @db.Uuid
  restaurantId    String   @map("restaurant_id") @db.Uuid
  quantity        Decimal  @default(0) @db.Decimal(12, 3)
  minStock        Decimal? @map("min_stock") @db.Decimal(12, 3)
  storageLocation String?  @map("storage_location")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  part         Part         @relation(fields: [partId], references: [id])
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])

  @@unique([partId, restaurantId])
  @@index([restaurantId])
  @@map("inventory")
}

/// Append-only stock ledger.
model InventoryTransaction {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  partId         String           @map("part_id") @db.Uuid
  restaurantId   String           @map("restaurant_id") @db.Uuid
  type           InventoryTxnType
  /// Positive for receipts/returns, negative for consumption.
  quantityDelta  Decimal          @map("quantity_delta") @db.Decimal(12, 3)
  balanceAfter   Decimal          @map("balance_after") @db.Decimal(12, 3)
  unitCost       Decimal?         @map("unit_cost") @db.Decimal(12, 2)
  /// e.g. WORK_ORDER / PURCHASE_ORDER / MANUAL
  referenceType  String?          @map("reference_type")
  referenceId    String?          @map("reference_id") @db.Uuid
  actorId        String?          @map("actor_id") @db.Uuid
  reason         String?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  part         Part         @relation(fields: [partId], references: [id])
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])
  actor        User?        @relation(fields: [actorId], references: [id])

  @@index([partId, restaurantId, createdAt])
  @@index([referenceType, referenceId])
  @@index([organizationId, createdAt])
  @@map("inventory_transactions")
}

// =============================================================================
// Vendors & purchasing
// =============================================================================

model Vendor {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  name           String
  contactName    String?          @map("contact_name")
  email          String?
  phone          String?
  altPhone       String?          @map("alt_phone")
  address        String?
  city           String?
  categories     VendorCategory[] @default([])
  taxId          String?          @map("tax_id")
  notes          String?
  archivedAt     DateTime?        @map("archived_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])

  vendorRestaurants VendorRestaurant[]
  assets            Asset[]
  preferredForParts Part[]
  invoices          VendorInvoice[]
  purchaseOrders    PurchaseOrder[]

  @@unique([organizationId, name])
  @@map("vendors")
}

model VendorRestaurant {
  vendorId     String @map("vendor_id") @db.Uuid
  restaurantId String @map("restaurant_id") @db.Uuid

  vendor     Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([vendorId, restaurantId])
  @@index([restaurantId])
  @@map("vendor_restaurants")
}

model VendorInvoice {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  vendorId        String    @map("vendor_id") @db.Uuid
  restaurantId    String?   @map("restaurant_id") @db.Uuid
  workOrderId     String?   @map("work_order_id") @db.Uuid
  purchaseOrderId String?   @map("purchase_order_id") @db.Uuid
  invoiceNumber   String    @map("invoice_number")
  amount          Decimal   @db.Decimal(12, 2)
  currency        String    @default("INR")
  invoiceDate     DateTime  @map("invoice_date") @db.Date
  dueDate         DateTime? @map("due_date") @db.Date
  paidAt          DateTime? @map("paid_at") @db.Timestamptz
  documentId      String?   @unique @map("document_id") @db.Uuid
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization  Organization   @relation(fields: [organizationId], references: [id])
  vendor        Vendor         @relation(fields: [vendorId], references: [id])
  restaurant    Restaurant?    @relation(fields: [restaurantId], references: [id])
  workOrder     WorkOrder?     @relation(fields: [workOrderId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  document      Document?      @relation(fields: [documentId], references: [id])

  @@unique([vendorId, invoiceNumber])
  @@index([vendorId, invoiceDate])
  @@index([restaurantId, invoiceDate])
  @@map("vendor_invoices")
}

model PurchaseOrder {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @map("organization_id") @db.Uuid
  /// PO-000123
  code               String
  vendorId           String              @map("vendor_id") @db.Uuid
  restaurantId       String              @map("restaurant_id") @db.Uuid
  status             PurchaseOrderStatus @default(DRAFT)
  requestedById      String              @map("requested_by_id") @db.Uuid
  approvedById       String?             @map("approved_by_id") @db.Uuid
  submittedAt        DateTime?           @map("submitted_at") @db.Timestamptz
  approvedAt         DateTime?           @map("approved_at") @db.Timestamptz
  orderedAt          DateTime?           @map("ordered_at") @db.Timestamptz
  expectedAt         DateTime?           @map("expected_at") @db.Date
  receivedAt         DateTime?           @map("received_at") @db.Timestamptz
  cancelledAt        DateTime?           @map("cancelled_at") @db.Timestamptz
  cancellationReason String?             @map("cancellation_reason")
  subtotal           Decimal             @default(0) @db.Decimal(12, 2)
  tax                Decimal             @default(0) @db.Decimal(12, 2)
  total              Decimal             @default(0) @db.Decimal(12, 2)
  currency           String              @default("INR")
  notes              String?
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  vendor       Vendor       @relation(fields: [vendorId], references: [id])
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])
  requestedBy  User         @relation("PoRequester", fields: [requestedById], references: [id])
  approvedBy   User?        @relation("PoApprover", fields: [approvedById], references: [id])

  items    PurchaseOrderItem[]
  receipts PoReceipt[]
  invoices VendorInvoice[]

  @@unique([organizationId, code])
  @@index([restaurantId, status])
  @@index([vendorId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String   @id @default(uuid()) @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  partId          String   @map("part_id") @db.Uuid
  description     String?
  qtyOrdered      Decimal  @map("qty_ordered") @db.Decimal(12, 3)
  qtyReceived     Decimal  @default(0) @map("qty_received") @db.Decimal(12, 3)
  unitCost        Decimal  @map("unit_cost") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  purchaseOrder PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  part          Part            @relation(fields: [partId], references: [id])
  receiptLines  PoReceiptLine[]

  @@unique([purchaseOrderId, partId])
  @@map("purchase_order_items")
}

/// One receiving event (partial or full) against a purchase order.
model PoReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  receivedById    String   @map("received_by_id") @db.Uuid
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz
  notes           String?

  purchaseOrder PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receivedBy    User            @relation(fields: [receivedById], references: [id])
  lines         PoReceiptLine[]

  @@index([purchaseOrderId])
  @@map("po_receipts")
}

model PoReceiptLine {
  id                  String  @id @default(uuid()) @db.Uuid
  receiptId           String  @map("receipt_id") @db.Uuid
  purchaseOrderItemId String  @map("purchase_order_item_id") @db.Uuid
  quantity            Decimal @db.Decimal(12, 3)

  receipt           PoReceipt         @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])

  @@index([purchaseOrderItemId])
  @@map("po_receipt_lines")
}

// =============================================================================
// Platform: documents, notifications, audit, settings
// =============================================================================

/// Licenses, certificates, AMCs, contracts, manuals, warranty docs, invoices…
model Document {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  restaurantId   String?           @map("restaurant_id") @db.Uuid
  ownerType      DocumentOwnerType @map("owner_type")
  ownerId        String            @map("owner_id") @db.Uuid
  docType        DocumentType      @default(OTHER) @map("doc_type")
  title          String
  storageKey     String            @unique @map("storage_key")
  fileName       String            @map("file_name")
  mimeType       String            @map("mime_type")
  sizeBytes      Int               @map("size_bytes")
  issuedAt       DateTime?         @map("issued_at") @db.Date
  /// Drives expiry reminders for licenses, AMCs and warranties.
  expiresAt      DateTime?         @map("expires_at") @db.Date
  uploadedById   String            @map("uploaded_by_id") @db.Uuid
  archivedAt     DateTime?         @map("archived_at") @db.Timestamptz
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  organization  Organization   @relation(fields: [organizationId], references: [id])
  restaurant    Restaurant?    @relation(fields: [restaurantId], references: [id])
  uploadedBy    User           @relation(fields: [uploadedById], references: [id])
  vendorInvoice VendorInvoice?

  @@index([ownerType, ownerId])
  @@index([restaurantId, docType])
  @@index([expiresAt])
  @@map("documents")
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  recipientId    String           @map("recipient_id") @db.Uuid
  type           NotificationType
  title          String
  body           String?
  entityType     String?          @map("entity_type")
  entityId       String?          @map("entity_id") @db.Uuid
  /// Where the notification takes the user when tapped.
  actionUrl      String?          @map("action_url")
  priority       Priority         @default(MEDIUM)
  readAt         DateTime?        @map("read_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  recipient    User         @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@index([entityType, entityId])
  @@map("notifications")
}

model NotificationPreference {
  userId String           @map("user_id") @db.Uuid
  type   NotificationType
  inApp  Boolean          @default(true) @map("in_app")
  email  Boolean          @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
  @@map("notification_preferences")
}

/// Append-only. Who did what, when, to which record, with before/after values.
model AuditLog {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  restaurantId   String?         @map("restaurant_id") @db.Uuid
  actorId        String?         @map("actor_id") @db.Uuid
  /// e.g. "work_order.created", "work_order.assigned", "auth.login_failed"
  action         String
  entityType     AuditEntityType @map("entity_type")
  entityId       String?         @map("entity_id") @db.Uuid
  oldValue       Json?           @map("old_value")
  newValue       Json?           @map("new_value")
  metadata       Json?
  ip             String?
  userAgent      String?         @map("user_agent")
  requestId      String?         @map("request_id")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  restaurant   Restaurant?  @relation(fields: [restaurantId], references: [id])
  actor        User?        @relation(fields: [actorId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

/// Key/value configuration at organization or restaurant scope.
model Setting {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  scope          SettingScope
  restaurantId   String?      @map("restaurant_id") @db.Uuid
  /// "org" for organization scope, otherwise the restaurant id — lets the unique key work with NULLs.
  scopeKey       String       @map("scope_key")
  key            String
  value          Json
  updatedById    String?      @map("updated_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  restaurant   Restaurant?  @relation(fields: [restaurantId], references: [id])

  @@unique([organizationId, scopeKey, key])
  @@map("settings")
}

/// Atomic per-organization sequences for human-readable codes (WO-000123, AST-0042…).
model Counter {
  organizationId String @map("organization_id") @db.Uuid
  key            String
  value          Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@id([organizationId, key])
  @@map("counters")
}
